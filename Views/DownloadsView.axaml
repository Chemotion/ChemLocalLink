<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ChemLocalLink.ViewModels"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:converters="clr-namespace:ChemLocalLink.Utilities"
             xmlns:avalonia="https://github.com/projektanker/icons.avalonia"
             xmlns:extensions="clr-namespace:ChemLocalLink.Utilities"
             xmlns:i="https://github.com/avaloniaui"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="ChemLocalLink.Views.DownloadsView"
             x:DataType="viewModels:MainWindowViewModel"
             x:Name="parent">
    <UserControl.Resources>
        <converters:DateTimeToStringConverter x:Key="DateToString" />
        <converters:FileExtensionToIconConverter x:Key="FileExtensionToIcon" />
    </UserControl.Resources>
    <ListBox Background="Transparent"
             ItemsSource="{Binding DownloadedFiles}"
             IsVisible="{Binding HasFilesDownloaded}"
             SelectedIndex="{Binding SelectedDownloadedFileIndex, Mode=TwoWay}"
             x:Name="DownBox"
             Padding="24,16"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <Interaction.Behaviors>
            <EventTriggerBehavior EventName="DoubleTapped">
                <InvokeCommandAction Command="{Binding OnDownloadDoubleTapped}"
                                     PassEventArgsToCommand="True" />
            </EventTriggerBehavior>
        </Interaction.Behaviors>
        <ListBox.Styles>
            <Style Selector="ListBoxItem">
                <Setter Property="Padding"
                        Value="0" />
                <Setter Property="Margin"
                        Value="0,0,0,6" />
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderBrush"
                        Value="Transparent" />
                <Setter Property="BorderThickness"
                        Value="0" />
                <Setter Property="CornerRadius"
                        Value="10" />
            </Style>
            <Style Selector="ListBoxItem:pointerover">
                <Setter Property="Background"
                        Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
            </Style>
            <Style Selector="ListBoxItem:selected">
                <Setter Property="Background"
                        Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource SystemControlHighlightAltBaseHighBrush}" />
                <Setter Property="ContextMenu">
                    <Setter.Value>
                        <ContextMenu>
                            <MenuItem Header="Upload &amp; delete locally">
                                <Interaction.Behaviors>
                                    <extensions:WindowMenuBehavior ViewModel="{Binding $parent[UserControl].DataContext}"
                                                                   Commands="uploadndelete" />
                                </Interaction.Behaviors>
                            </MenuItem>
                            <MenuItem Header="Upload &amp; keep locally">
                                <Interaction.Behaviors>
                                    <extensions:WindowMenuBehavior ViewModel="{Binding $parent[UserControl].DataContext}"
                                                                   Commands="uploadnkeep" />
                                </Interaction.Behaviors>
                            </MenuItem>
                            <MenuItem Header="Delete file locally">
                                <Interaction.Behaviors>
                                    <extensions:WindowMenuBehavior ViewModel="{Binding $parent[UserControl].DataContext}"
                                                                   Commands="deleteFile" />
                                </Interaction.Behaviors>
                            </MenuItem>
                            <MenuItem Header="Open file">
                                <Interaction.Behaviors>
                                    <extensions:WindowMenuBehavior ViewModel="{Binding $parent[UserControl].DataContext}"
                                                                   Commands="openFile" />
                                </Interaction.Behaviors>
                            </MenuItem>
                            <MenuItem Header="Open folder">
                                <Interaction.Behaviors>
                                    <extensions:WindowMenuBehavior ViewModel="{Binding $parent[UserControl].DataContext}"
                                                                   Commands="openDir" />
                                </Interaction.Behaviors>
                            </MenuItem>
                        </ContextMenu>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Border Background="Transparent"
                        Padding="20,16"
                        CornerRadius="10">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="16"
                          RowSpacing="10">
                        <avalonia:Icon Value="{Binding FileName, Converter={StaticResource FileExtensionToIcon}}"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       Grid.RowSpan="2"
                                       Width="48"
                                       Height="48"
                                       FontSize="40"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding FileName, Converter={StaticResource FileExtensionToIcon}, ConverterParameter=color}" />
                        <TextBlock Text="{Binding FileName}"
                                   ToolTip.Tip="{Binding FileName}"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <TextBlock Text="{Binding FilePath}"
                                   ToolTip.Tip="{Binding FilePath}"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <StackPanel Grid.Row="0"
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Border Background="{DynamicResource SystemAccentColorLight2}"
                                    CornerRadius="14"
                                    Padding="10,5"
                                    IsVisible="{Binding IsEdited}">
                                <TextBlock Text="EDITED"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                            </Border>
                            <Border Background="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                    CornerRadius="14"
                                    Padding="10,5"
                                    IsVisible="{Binding IsKept}">
                                <TextBlock Text="KEPT"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="0"
                                    Grid.Column="3"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <Ellipse Width="10"
                                     Height="10"
                                     IsVisible="{Binding !IsKept}"
                                     Fill="{Binding Exp, Converter={StaticResource DateToString}, ConverterParameter={Binding IsKept}}"
                                     ToolTip.Tip="{Binding Exp, Converter={StaticResource DateToString}}" />
                            <TextBlock Text="{Binding FileSize}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding FileDownloadTimeStamp, Converter={StaticResource DateToString}}"
                                   Grid.Row="1"
                                   Grid.Column="2"
                                   Grid.ColumnSpan="2"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
