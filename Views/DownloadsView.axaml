<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ChemLocalLink.ViewModels"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:converters="clr-namespace:ChemLocalLink.Utilities"
             xmlns:avalonia="https://github.com/projektanker/icons.avalonia"
             xmlns:extensions="clr-namespace:ChemLocalLink.Utilities"
             xmlns:i="https://github.com/avaloniaui"
             xmlns:models="clr-namespace:ChemLocalLink.Models"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="ChemLocalLink.Views.DownloadsView"
             x:DataType="viewModels:MainWindowViewModel"
             x:Name="parent">
    <UserControl.Resources>
        <converters:DateTimeToStringConverter x:Key="DateToString" />
        <converters:FileExtensionToIconConverter x:Key="FileExtensionToIcon" />
        <converters:FileSelectionConverter x:Key="FileSelectionConverter" />
    </UserControl.Resources>
    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type models:DownloadModel}">
            <Border Background="Transparent"
                    Padding="16,10"
                    CornerRadius="10"
                    MinHeight="64"
                    Margin="-8,0,0,0"
                    ToolTip.Tip="{Binding FilePath}"
                    Classes="item-border">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Upload &amp; delete locally">
                            <Interaction.Behaviors>
                                <extensions:WindowMenuBehavior ViewModel="{Binding $parent[UserControl].DataContext}"
                                                               FileModel="{Binding}"
                                                               Commands="uploadndelete" />
                            </Interaction.Behaviors>
                        </MenuItem>
                        <MenuItem Header="Upload &amp; keep locally">
                            <Interaction.Behaviors>
                                <extensions:WindowMenuBehavior ViewModel="{Binding $parent[UserControl].DataContext}"
                                                               FileModel="{Binding}"
                                                               Commands="uploadnkeep" />
                            </Interaction.Behaviors>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Duplicate file">
                            <Interaction.Behaviors>
                                <extensions:WindowMenuBehavior ViewModel="{Binding $parent[UserControl].DataContext}"
                                                               FileModel="{Binding}"
                                                               Commands="duplicateFile" />
                            </Interaction.Behaviors>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Delete file locally">
                            <Interaction.Behaviors>
                                <extensions:WindowMenuBehavior ViewModel="{Binding $parent[UserControl].DataContext}"
                                                               FileModel="{Binding}"
                                                               Commands="deleteFile" />
                            </Interaction.Behaviors>
                        </MenuItem>
                        <MenuItem Header="Open file">
                            <Interaction.Behaviors>
                                <extensions:WindowMenuBehavior ViewModel="{Binding $parent[UserControl].DataContext}"
                                                               FileModel="{Binding}"
                                                               Commands="openFile" />
                            </Interaction.Behaviors>
                        </MenuItem>
                        <MenuItem Header="Open folder">
                            <Interaction.Behaviors>
                                <extensions:WindowMenuBehavior ViewModel="{Binding $parent[UserControl].DataContext}"
                                                               FileModel="{Binding}"
                                                               Commands="openDir" />
                            </Interaction.Behaviors>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid ColumnDefinitions="Auto,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="6">
                    <avalonia:Icon Value="{Binding FileName, Converter={StaticResource FileExtensionToIcon}}"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.RowSpan="2"
                                   Width="40"
                                   Height="40"
                                   FontSize="32"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding FileName, Converter={StaticResource FileExtensionToIcon}, ConverterParameter=color}" />
                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}"
                                   ToolTip.Tip="{Binding FileName}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Background="{DynamicResource SystemAccentColorLight2}"
                                CornerRadius="10"
                                Padding="8,2"
                                Classes="badge-border"
                                IsVisible="{Binding IsEdited}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4">
                                <avalonia:Icon Value="fa-solid fa-pen"
                                               Width="10"
                                               Height="10" />
                                <TextBlock Text="Edited"
                                           FontSize="10"
                                           Foreground="White" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                CornerRadius="10"
                                Padding="8,2"
                                Classes="badge-border"
                                IsVisible="{Binding IsKept}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4">
                                <avalonia:Icon Value="fa-solid fa-thumbtack"
                                               Width="10"
                                               Height="10" />
                                <TextBlock Text="Kept"
                                           FontSize="10"
                                           Foreground="White" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SystemAccentColorDark1}"
                                CornerRadius="10"
                                Padding="8,2"
                                Classes="badge-border"
                                IsVisible="{Binding IsCreated}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4">
                                <avalonia:Icon Value="fa-solid fa-plus"
                                               Width="10"
                                               Height="10" />
                                <TextBlock Text="Created"
                                           FontSize="10"
                                           Foreground="White" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Grid Grid.Row="1"
                          Grid.Column="1"
                          ColumnDefinitions="*,Auto"
                          VerticalAlignment="Center">
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4">
                                <avalonia:Icon Value="fa-solid fa-globe"
                                               Width="10"
                                               Height="10" />
                                <TextBlock Text="{Binding Origin}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                            <TextBlock Text="•"
                                       FontSize="11"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4">
                                <avalonia:Icon Value="fa-solid fa-file"
                                               Width="10"
                                               Height="10" />
                                <TextBlock Text="{Binding FileSize}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                            <TextBlock Text="•"
                                       FontSize="11"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <Border Background="{Binding Exp, Converter={StaticResource DateToString}}"
                                    CornerRadius="10"
                                    Padding="6,2"
                                    IsVisible="{Binding !IsKept}"
                                    ToolTip.Tip="{Binding Exp, Converter={StaticResource DateToString}, ConverterParameter=tooltip}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4">
                                    <avalonia:Icon Value="fa-solid fa-clock"
                                                   Width="10"
                                                   Height="10"
                                                   Foreground="White" />
                                    <TextBlock Text="{Binding Exp, Converter={StaticResource DateToString}, ConverterParameter=short}"
                                               FontSize="10"
                                               FontWeight="Medium"
                                               Foreground="White" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding FileDownloadTimeStamp, Converter={StaticResource DateToString}}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>
    <TreeView Background="Transparent"
              ItemsSource="{Binding DownloadedByOrigin}"
              IsVisible="{Binding HasFilesDownloaded}"
              x:Name="DownTree"
              Padding="24,12"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <TreeView.Styles>
            <Style Selector="TreeViewItem">
                <Setter Property="Margin"
                        Value="0,0,0,4" />
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderBrush"
                        Value="Transparent" />
                <Setter Property="BorderThickness"
                        Value="0" />
                <Setter Property="CornerRadius"
                        Value="8" />
                <Setter Property="IsExpanded"
                        Value="True" />
                <Setter Property="Focusable"
                        Value="False" />
                <Setter Property="IsTabStop"
                        Value="False" />
                <Setter Property="IsSelected"
                        Value="False" />
            </Style>
            <Style Selector="TreeViewItem:pointerover">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderBrush"
                        Value="Transparent" />
            </Style>
            <Style Selector="TreeViewItem:selected">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderBrush"
                        Value="Transparent" />
                <Setter Property="IsSelected"
                        Value="False" />
            </Style>
            <Style Selector="TreeViewItem:pressed">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderBrush"
                        Value="Transparent" />
            </Style>
            <Style Selector="TreeViewItem:focus">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderBrush"
                        Value="Transparent" />
            </Style>
            <Style Selector="TreeViewItem /template/ ContentPresenter">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderBrush"
                        Value="Transparent" />
            </Style>
            <Style Selector="TreeViewItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderBrush"
                        Value="Transparent" />
            </Style>
            <Style Selector="TreeViewItem:selected /template/ ContentPresenter">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderBrush"
                        Value="Transparent" />
            </Style>
            <Style Selector="TreeViewItem:pressed /template/ ContentPresenter">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderBrush"
                        Value="Transparent" />
            </Style>
            <Style Selector="TreeViewItem Border.item-border">
                <Setter Property="Background"
                        Value="Transparent" />
            </Style>
            <Style Selector="TreeViewItem:pointerover Border.item-border">
                <Setter Property="Background"
                        Value="Transparent" />
            </Style>
            <Style Selector="Border.badge-border">
                <Setter Property="Background"
                        Value="{Binding RelativeSource={RelativeSource Self}, Path=Background}" />
            </Style>
            <Style Selector="Border.folder-border">
                <Setter Property="Background"
                        Value="Transparent" />
            </Style>
            <Style Selector="Border.divider-border">
                <Setter Property="Background"
                        Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </Style>
            <Style Selector="ToolTip">
                <Setter Property="Background"
                        Value="{DynamicResource ToolTipBackground}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource ToolTipBorderBrush}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource ToolTipForeground}" />
            </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
            <TreeDataTemplate DataType="{x:Type models:OriginGroupModel}"
                              ItemsSource="{Binding Items}">
                <Border Background="Transparent"
                        Padding="2,0"
                        CornerRadius="6"
                        IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <avalonia:Icon Value="fa-solid fa-folder"
                                       Width="16"
                                       Height="16" />
                        <TextBlock Text="{Binding Origin}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    </StackPanel>
                </Border>
            </TreeDataTemplate>
        </TreeView.ItemTemplate>
        <TreeView.DataTemplates>
            <DataTemplate DataType="{x:Type models:FolderModel}">
                <StackPanel Background="Transparent">
                    <StackPanel.Styles>
                        <Style Selector="StackPanel">
                            <Setter Property="Background"
                                    Value="Transparent" />
                        </Style>
                        <Style Selector="StackPanel:pointerover">
                            <Setter Property="Background"
                                    Value="Transparent" />
                        </Style>
                    </StackPanel.Styles>
                    <Border Background="Transparent"
                            Padding="2,4"
                            CornerRadius="6"
                            Margin="0,2"
                            Classes="folder-border"
                            IsHitTestVisible="False">
                        <Border.Styles>
                            <Style Selector="Border.folder-border">
                                <Setter Property="Background"
                                        Value="Transparent" />
                            </Style>
                            <Style Selector="Border.folder-border:pointerover">
                                <Setter Property="Background"
                                        Value="Transparent" />
                            </Style>
                        </Border.Styles>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <Border Width="1"
                                    Height="20"
                                    Background="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                    Opacity="0.3"
                                    Classes="divider-border"
                                    Margin="4,0" />
                            <avalonia:Icon Value="fa-solid fa-folder-open"
                                           Width="16"
                                           Height="16"
                                           Foreground="{DynamicResource SystemAccentColor}" />
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            <TextBlock Text="{Binding Files.Count, StringFormat=({0})}"
                                       FontSize="10"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="24,0,0,8">
                        <ItemsControl ItemsSource="{Binding Files}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button BorderThickness="0"
                                            Padding="0"
                                            Margin="0,1"
                                            CornerRadius="6"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Command="{Binding $parent[TreeView].((viewModels:MainWindowViewModel)DataContext).SelectFileCommand}"
                                            CommandParameter="{Binding}">
                                        <Button.Background>
                                            <MultiBinding Converter="{StaticResource FileSelectionConverter}">
                                                <Binding Path="." />
                                                <Binding Path="$parent[TreeView].((viewModels:MainWindowViewModel)DataContext).SelectedDownloadedFile" />
                                            </MultiBinding>
                                        </Button.Background>
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
                                            </Style>
                                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource SystemControlBackgroundListMediumBrush}" />
                                            </Style>
                                        </Button.Styles>
                                        <ContentControl Content="{Binding}" />
                                        <Interaction.Behaviors>
                                            <EventTriggerBehavior EventName="DoubleTapped">
                                                <InvokeCommandAction Command="{Binding $parent[TreeView].((viewModels:MainWindowViewModel)DataContext).OnDownloadDoubleTapped}"
                                                                     CommandParameter="{Binding}" />
                                            </EventTriggerBehavior>
                                        </Interaction.Behaviors>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </TreeView.DataTemplates>
    </TreeView>
</UserControl>
